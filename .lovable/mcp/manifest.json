      {
        "name": "create_inquiry",
        "title": "Create admission inquiry",
        "description": "Record a new admission enquiry for a prospective student.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "parent_name": {
              "type": "string",
              "minLength": 1,
              "description": "Parent or guardian name."
            },
            "child_name": {
              "type": "string",
              "minLength": 1,
              "description": "Student's name."
            },
            "mobile": {
              "type": "string",
              "minLength": 10,
              "maxLength": 15,
              "description": "Contact mobile number."
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "class_interest": {
              "description": "Class of interest, e.g. Class 11 Commerce.",
              "type": "string",
              "minLength": 1
            },
            "branch_id": {
              "description": "Campus id from list_branches.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "notes": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "parent_name",
            "child_name",
            "mobile"
          ]
        },
        "outputSchema": null
      }
